COMPOSE_PROJECT_NAME=sisdeveagro
TZ=America/Sao_Paulo

# Endereço HTTPS publicado pelo gateway. Use um IP da rede interna.
HTTPS_BIND_IP=192.168.1.7
HTTPS_PORT=443
APP_URL=https://${HTTPS_BIND_IP}
API_BASE_PATH=/api
CERT_VALID_DAYS=825

# Laravel
APP_NAME="SISDEVE AGRO"
APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:JiQYl4vI0dQKwhVLrmfLCa/hr1pD7a/q7+HNCD+TnIo=
LOG_CHANNEL=stack
LOG_LEVEL=info

# MySQL
MYSQL_DATABASE=agro
MYSQL_USER=agro
MYSQL_PASSWORD=agro
MYSQL_ROOT_PASSWORD=agro

# Redis
REDIS_PASSWORD=agro

# Backup MySQL
BACKUP_RETENTION_DAYS=14
BACKUP_TIME=02:30

# Must match the Linux user that owns the project files.
# scripts/setup.sh updates these automatically on first setup.
HOST_UID=1000
HOST_GID=1000

# Laravel API/auth
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=${HTTPS_BIND_IP}
